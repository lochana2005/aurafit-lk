<svg width="300" height="300" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg-wheyprotein" x1="0" y1="0" x2="300" y2="300" gradientUnits="userSpaceOnUse">
      <stop stop-color="#191920"/>
      <stop offset="0.5" stop-color="#121216"/>
      <stop offset="1" stop-color="#0A0A0C"/>
    </linearGradient>
    <linearGradient id="champagne-wheyprotein" x1="0" y1="0" x2="1" y2="1">
      <stop stop-color="#FBF4DE"/>
      <stop offset="0.5" stop-color="#E2C275"/>
      <stop offset="1" stop-color="#A8842E"/>
    </linearGradient>
    <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
      <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(255,255,255,0.025)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="300" height="300" fill="url(#bg-wheyprotein)"/>
  <rect width="300" height="300" fill="url(#grid)"/>
  <rect x="1" y="1" width="298" height="298" rx="12" stroke="rgba(255,255,255,0.08)"/>
  <circle cx="150" cy="134" r="48" stroke="rgba(226,194,117,0.25)" stroke-dasharray="4 4" fill="none"/>
  <text x="150" y="146" text-anchor="middle" fill="url(#champagne-wheyprotein)" font-family="sans-serif" font-weight="800" font-size="12" letter-spacing="2">
    WHEY PROTEIN
  </text>
  <text x="150" y="170" text-anchor="middle" fill="#A1A1AA" font-family="sans-serif" font-size="11" letter-spacing="1">
    CATEGORY STUDIO PNG
  </text>
</svg>